# --- Claude ---
# If set, Claude Code bills this API key. If unset, it uses your Claude Code login.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Execution ---
# Leave true until you have reviewed several days of logs. false places real orders.
DRY_RUN=true
POLL_INTERVAL_SECONDS=3600
MARKET_HOURS_ONLY=true
# Claude API spend cap per cycle. This is the cost of running the agent, not trade size.
MAX_CYCLE_BUDGET_USD=0.50
MAX_CYCLE_TURNS=60
# How many past cycles the agent sees as memory.
JOURNAL_LOOKBACK=5

# --- Hard risk limits ---
# Per-order ceiling as a share of account value. The agent sizes freely under this without
# asking, and it scales as the account grows. 0.50 = half the account on one order.
MAX_TRADE_PCT=0.50
MAX_POSITION_PCT=0.30
MAX_DAILY_LOSS_PCT=0.15
# Dollar-denominated daily loss breaker. Above zero it overrides the percentage above.
MAX_DAILY_LOSS_USD=0
MAX_TRADES_PER_DAY=3
MIN_CASH_BUFFER=0
# There is no watchlist: the agent picks its own symbols. This spread cap is the
# liquidity guard that replaces one. 0.025 = 2.5%.
MAX_SPREAD_PCT=0.025
# Anti-churn: hours before the same pair may be bought again. Sells are never blocked.
SYMBOL_COOLDOWN_HOURS=24
# Minimum hold before selling. 0 = off; raising it can trap a position that should be exited.
MIN_HOLD_HOURS=0
# Advisory exit thresholds shown against each open position. Nothing sells automatically.
STOP_LOSS_PCT=0.15
TAKE_PROFIT_PCT=0.25
# How many pairs get price-history context (1d/7d/30d and 30-day range) in the prompt.
CONTEXT_SYMBOLS_MAX=24

# --- Crypto headlines (publisher RSS, no API key) ---
# Fetched by this project's code and summarized into the prompt; the agent has no web access.
CRYPTO_NEWS_ENABLED=true
CRYPTO_NEWS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed
CRYPTO_NEWS_LOOKBACK_HOURS=24
CRYPTO_NEWS_MAX_ITEMS=20
CRYPTO_NEWS_TIMEOUT_SECONDS=10
# Freshness: an order resting on data older than these is rejected, so decisions are always
# made on live prices rather than remembered ones.
MAX_QUOTE_AGE_SECONDS=300
MAX_STATE_AGE_SECONDS=900

# --- Congressional disclosures (STOCK Act) ---
# Fetched by this project's code and summarized into the prompt. The agent itself has no
# web access. Disclosures lag the actual trade by up to ~45 days.
CONGRESS_ENABLED=true
CONGRESS_API_URL=https://www.bargo.ai/free-apis/congress/v1/trades
CONGRESS_LOOKBACK_DAYS=60
CONGRESS_MAX_ROWS=40
CONGRESS_TIMEOUT_SECONDS=20

# Research desk: a read-only agent that briefs the trader before each session.
RESEARCH_ENABLED=true
RESEARCH_EFFORT=max
RESEARCH_MAX_TURNS=150
RESEARCH_BUDGET_USD=10.00
RESEARCH_TIMEOUT_MINUTES=45
# Live mover monitor thresholds (fractions), feeding the research desk.
MOVER_1H_PCT=0.04
MOVER_24H_PCT=0.10
MOVER_VOLUME_SURGE_PCT=1.50

LOG_DIR=logs
